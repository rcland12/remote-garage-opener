# Copy to garage-api.env and fill in. That file is gitignored.
#
#   cp garage-api.env.example garage-api.env
#   chmod 600 garage-api.env
#
# Note what this file does NOT contain: no database password, no SSH key, no
# docker socket, no path to anything on the host. The only thing this service
# does is make one HTTP call to the ESP32 on your LAN, which is what lets it
# run as an unprivileged user with a read-only filesystem.


# --- How callers authenticate -----------------------------------------------
#
# access  Cloudflare Access. The endpoint gets a public hostname; Cloudflare's
#         edge decides who gets through and this service verifies the signed
#         assertion it forwards. This is the mode a phone Shortcut can use,
#         because a Shortcut cannot bring up a VPN first.
#
# token   A bearer key per client, compared here. For Tailscale, WireGuard or
#         an SSH port forward, where the transport is already private and
#         there is no Cloudflare in the path.
#
# Do not run token mode on anything the internet can reach. There is no TLS
# here and no lockout; a public listener is one guessed key from an open
# garage. Put a real reverse proxy with TLS in front of it, or use access.
AUTH_MODE=access


# --- Cloudflare Access (AUTH_MODE=access) -----------------------------------

# Zero Trust > Settings > Custom Pages, or the team name in the dashboard URL.
# Account-wide: the same value for every Access application you own.
ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com

# Zero Trust > Access > Applications > <your app> > Overview > Application
# Audience (AUD) Tag. A 64-character hex string, unique to that application.
ACCESS_AUD=


# --- API keys (AUTH_MODE=token) ---------------------------------------------
#
#   API_CLIENTS=name:key;name:key
#
# The name is the identity that API_SCOPES below grants actions to, and the
# name that lands in the audit log. Issue one key per device, never a shared
# one: revoking a roommate's access should not mean re-pairing your own phone.
#
# Minimum 32 characters, enforced at boot. Generate one with:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Callers send it as `X-Api-Key: <key>` or `Authorization: Bearer <key>`.
API_CLIENTS=


# --- Authorisation ----------------------------------------------------------
#
# Required in both modes. Empty is a fatal boot error, not a permissive
# default.
#
#   API_SCOPES=<identity>=<action>,<action>;<identity>=<action>
#
# An identity is:
#   access mode  a service token Client ID (the FULL value, including the
#                trailing `.access`) or the email of an interactive login
#   token mode   a name from API_CLIENTS above
#
# An action is an exact name, a prefix wildcard (`garage.*`), or a bare `*`.
#
#   garage.toggle     POST /garage/toggle     pulse the door relay
#   garage.selftest   POST /garage/selftest   the toggle path, no pulse
#   garage.status     GET  /garage/status     device uptime and RSSI
#   garage.log        GET  /garage/log        the device's event ring
#   garage.audit      GET  /garage/audit      who has pressed the button
#   service.audit     GET  /service/audit     this service's whole event log
#
# Not scopeable: GET /service/actions only ever describes the caller to
# itself, and GET /service/health is unauthenticated for health checks and
# must not be published by the tunnel.
#
# Give each identity the narrowest set that does its job. A roommate who only
# opens the door wants `garage.toggle,garage.selftest` - not `garage.audit`,
# which is the record of who opened it and when.
#
# MUST BE ONE LINE. An env file has no line continuation: a trailing backslash
# is read as part of the value, and the result is a scope entry that silently
# never matches. An identity listed twice keeps only the last entry, so give
# each one entry with all of its actions in it. Examples, pick one shape:
#
#   API_SCOPES=aaaa.access=garage.toggle,garage.selftest;you@example.com=*
#   API_SCOPES=phone=garage.toggle,garage.selftest;laptop=*
API_SCOPES=


# --- The controller ---------------------------------------------------------

# The ESP32-S3's address on your LAN. Give it a DHCP reservation in the router
# or set STATIC_IP in firmware/secrets.py, so this does not move.
GARAGE_HOST=192.168.1.50

# Must match API_TOKEN in firmware/secrets.py on the device. This is the only
# copy of it outside the ESP32; it never goes to a phone or a Shortcut.
#
# Unset is not fatal - the service still boots and the read-only routes still
# work - but /garage/toggle refuses with a 502 rather than pulsing anything.
# Failing closed for a door means refusing to move it.
GARAGE_TOKEN=

DEVICE_TIMEOUT_S=8

# Seconds to refuse a second pulse after one succeeds. Guards against a phone
# retrying a request it thought timed out and reversing a moving door. The
# firmware enforces its own 2 s window underneath this.
TOGGLE_COOLDOWN_S=5


# --- Service ----------------------------------------------------------------

# 0.0.0.0 is right behind Docker or a tunnel. On a laptop running the service
# natively with nothing in front of it, 127.0.0.1 is tighter, and the
# Tailscale address is tighter still.
LISTEN_ADDR=0.0.0.0
LISTEN_PORT=8080

# Requests per minute per identity, across every route. 0 disables it. A
# human presses this a few times a day, so anything near the limit is a retry
# loop, which is what should be cut off.
RATE_LIMIT_PER_MIN=60

# Events kept in memory for /garage/audit and /service/audit. Lost on restart;
# the process's stdout is the durable copy.
AUDIT_SIZE=200

TZ=America/New_York
